# Copiar a .env y rellenar. NUNCA versionar el .env real.

# Cadena de conexión de PostgreSQL.
DATABASE_URI=postgres://trauma:CAMBIAR_ESTA_CLAVE@localhost:5432/trauma

# Secreto de firma de sesiones de Payload.
# Generar con: openssl rand -base64 48
PAYLOAD_SECRET=CAMBIAR_POR_UN_SECRETO_LARGO_Y_ALEATORIO

# URL pública de la plataforma.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Credenciales del contenedor de PostgreSQL (docker-compose).
POSTGRES_USER=trauma
POSTGRES_PASSWORD=CAMBIAR_ESTA_CLAVE
POSTGRES_DB=trauma

# Token del túnel de Cloudflare. Solo en el servidor de producción.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Correo saliente (opcional) ---
# Sin esto, Payload escribe los mensajes en la consola y la recuperación de
# contraseña no llega a destino. Ver docs/CORREO.md
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_DESDE=no-responder@sudominio.cl
