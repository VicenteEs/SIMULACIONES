# Copiar a .env y rellenar. NUNCA versionar el .env real.
#
# En el servidor, scripts/instalar-servidor.sh genera este archivo con secretos
# aleatorios y no hace falta escribir nada a mano salvo la dirección pública.

# --- Base de datos ---------------------------------------------------------
# Credenciales del contenedor de PostgreSQL (las usa docker compose).
POSTGRES_USER=trauma
POSTGRES_PASSWORD=CAMBIAR_ESTA_CLAVE
POSTGRES_DB=trauma

# Cadena de conexión que usa la aplicación.
# En desarrollo apunta a localhost; en producción, docker compose la construye
# sola apuntando al contenedor "db", y esta línea se ignora.
DATABASE_URI=postgres://trauma:CAMBIAR_ESTA_CLAVE@127.0.0.1:5432/trauma

# --- Sesiones --------------------------------------------------------------
# Secreto de firma de sesiones de Payload.
# Generar con: openssl rand -base64 48
# Cambiarlo cierra la sesión de todo el mundo; no se rota sin avisar.
PAYLOAD_SECRET=CAMBIAR_POR_UN_SECRETO_LARGO_Y_ALEATORIO

# --- Dirección pública -----------------------------------------------------
# En producción debe ser https://... : sin cifrado, la cookie de sesión viaja
# en claro. Con Tailscale, el nombre que da "tailscale serve status".
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Zona horaria del contenedor. Afecta a las fechas que muestra el panel y a la
# hora del respaldo diario.
TZ=America/Santiago

# --- Túnel -----------------------------------------------------------------
# Solo si se despliega con TUNEL=cloudflare. Con Tailscale se deja vacío.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Correo saliente (opcional) --------------------------------------------
# Sin esto, Payload escribe los mensajes en la consola y la recuperación de
# contraseña no llega a destino. El panel ofrece entonces el enlace de
# restablecimiento para entregarlo a mano. Ver docs/CORREO.md
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_DESDE=no-responder@sudominio.cl

# --- Respaldos -------------------------------------------------------------
# Dónde escribe los volcados el panel. Dentro del contenedor es /backups, que
# está montado sobre la carpeta "backups" del servidor. En desarrollo, si se
# deja vacío, se usa ./backups.
# RESPALDOS_DIR=/backups

# Días de respaldos que conserva scripts/respaldar.sh antes de descartar.
DIAS_A_CONSERVAR=30

# --- Pruebas (solo en desarrollo) ------------------------------------------
# Las dos que gobiernan las pruebas de integración, y no hay más. Se dejan
# comentadas a propósito: sin base, la suite sale en ROJO con la causa escrita,
# y eso es lo que se quiere. Son las únicas pruebas que comprueban que los
# permisos llegan hasta la consulta, así que su ausencia se anuncia en vez de
# desaparecer en silencio. La explicación entera está en README.md.
#
# Permiso escrito a mano para trabajar sin base: las de integración se omiten y
# el resultado queda verde. Se pone a sabiendas y se quita al terminar; dejarlo
# puesto en la shell es creer que se comprobó el control de acceso sin haberlo
# comprobado.
# OMITIR_INTEGRACION=1
#
# Lo contrario: las declara obligatorias, y ahí el permiso de arriba ya no vale.
# `npm run test:integration` se lo pone a sí mismo, y cualquier servidor de
# integración consigue lo mismo con CI=1.
# EXIGIR_INTEGRACION=1
