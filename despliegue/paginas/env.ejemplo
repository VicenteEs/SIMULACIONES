# TraumaHub en el servidor de `paginas/`.
# Copiar como .env dentro del clon y completar. Permisos 600.
#
#   openssl rand -base64 24 | tr -d '/+=' | cut -c1-24    → POSTGRES_PASSWORD
#   openssl rand -base64 48                               → PAYLOAD_SECRET

POSTGRES_USER=trauma
POSTGRES_PASSWORD=
POSTGRES_DB=trauma

PAYLOAD_SECRET=

# Dirección pública completa, **con el puerto y con el prefijo**.
#
# El puerto tiene que estar: la entrada es un Funnel de Tailscale en el 10000,
# y una dirección sin él manda los enlaces absolutos —el de recuperar
# contraseña, el de los archivos subidos— a un puerto donde no hay nada.
NEXT_PUBLIC_SERVER_URL=https://ved.tailc2094f.ts.net:10000/traumahub

TZ=America/Santiago

# --- Correo saliente (opcional) --------------------------------------------
# Sin esto, la recuperación de contraseña no llega a destino y hay que
# entregar el enlace a mano desde el panel. Ver docs/CORREO.md
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_DESDE=

# Días de respaldos que se conservan.
DIAS_A_CONSERVAR=30
