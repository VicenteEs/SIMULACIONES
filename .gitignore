# dependencias
node_modules/
.pnpm-store/

# build
.next/
out/
dist/
build/
*.tsbuildinfo

# Material de terceros del que se parte para preparar el atlas. No se versiona:
# lo que si viaja en el repositorio es el resultado, public/atlas/, que es lo
# que la plataforma sirve. Ver scripts/atlas/preparar.mjs
/.vendor/

# Ajustes propios de un servidor concreto. La barra inicial ancla el patron a
# la raiz: sin ella tambien ignoraria la plantilla de despliegue/paginas/, que
# si tiene que viajar en el repositorio.
/docker-compose.override.yml

# entorno — NUNCA versionar secretos
.env
.env.*
!.env.example

# payload
# Los archivos subidos viven fuera de `public/` a propósito: dentro, Next los
# servía además como estáticos y se saltaba el control de acceso. Ver el
# comentario de src/collections/Medios.ts.
/medios/*
!/medios/.gitkeep
!/medios/modelos/
/medios/modelos/*
!/medios/modelos/.gitkeep
!/medios/pagina/
/medios/pagina/*
!/medios/pagina/.gitkeep
/src/app/(payload)/admin/importMap.js

# Los libros, las fichas de la ingesta y sus figuras (D-144): varios GB de
# material con derechos de autor, que el repositorio —en GitHub— no puede
# llevar. Ya estaba fuera de la imagen (`.dockerignore`) y no de aquí, así que
# un `git add -A` lo subía entero.
/data_traumahub/

# base de datos y respaldos
*.sql
*.dump
/backups/
playwright/.cache/

# modelos 3D subidos por usuarios (viven en el volumen, no en git)
/uploads/

# pruebas
/coverage/
/test-results/
/playwright-report/
/blob-report/
.playwright/

# sistema
.DS_Store
Thumbs.db
desktop.ini

# editores
.vscode/*
!.vscode/extensions.json
.idea/

# logs
*.log
npm-debug.log*

# Modelos de ejemplo generados por scripts/modelo-de-prueba.mjs. Se regeneran
# con un comando y no tienen por qué viajar en el repositorio.
/ejemplos/

# Caché de Python de los guiones de Blender
__pycache__/

# Lo intermedio de la generación de fascias (P-006): mallas finas, vistas de
# control y .blend. Se reconstruye con `python scripts/atlas/fascias/generar.py`;
# lo que viaja en el repositorio es el resultado, public/atlas/cuerpo-15.bin.gz.
/scripts/atlas/fascias/salida/

# Lo mismo para la piel (D-224): la malla lisa que deja `python scripts/atlas/piel/generar.py` y que
# `recalcular-piel.mjs` empuja y escribe en el atlas. Pesa unos megabytes y se rehace en un minuto.
/scripts/atlas/piel/salida/

# Y para los huesos largos (D-335, D-336): las mallas y el manifiesto de medidas que deja
# `python scripts/atlas/huesos/generar.py`, y que `node scripts/atlas/poner-huesos.mjs --aplicar`
# escribe en el atlas. Lo que viaja es el resultado, public/atlas/cuerpo-12 y cuerpo-13.
/scripts/atlas/huesos/salida/
